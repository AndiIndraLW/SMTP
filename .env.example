# ─────────────────────────────────────────────────────────
# SMTP Server
# ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true = TLS (port 465) | false = STARTTLS (port 587)
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here

# ─────────────────────────────────────────────────────────
# Sender Identity
# ─────────────────────────────────────────────────────────
FROM_NAME=Your Company Name
FROM_EMAIL=you@gmail.com   # Defaults to SMTP_USER if omitted

# ─────────────────────────────────────────────────────────
# Email Content
# ─────────────────────────────────────────────────────────
MAIL_SUBJECT=Hey {{firstname}}, here's something just for you 🎉
TEMPLATE_PATH=./template.html

# ─────────────────────────────────────────────────────────
# Contact List
# ─────────────────────────────────────────────────────────
CSV_PATH=./contacts.csv

# ─────────────────────────────────────────────────────────
# Batch & Rate-Limiting
# ─────────────────────────────────────────────────────────
BATCH_SIZE=100             # Emails per batch
BATCH_DELAY_MINUTES=30     # Pause between batches (0 = no pause)

# ─────────────────────────────────────────────────────────
# Per-Email Jitter (avoids SMTP port hammering)
# ─────────────────────────────────────────────────────────
JITTER_MIN_MS=500          # Min wait between individual sends (ms)
JITTER_MAX_MS=1200         # Max wait between individual sends (ms)

# ─────────────────────────────────────────────────────────
# Retry Logic
# ─────────────────────────────────────────────────────────
MAX_RETRIES=3              # Max attempts per failed email
RETRY_BASE_MS=2000         # Base backoff delay (doubles each retry)

# ─────────────────────────────────────────────────────────
# Output Files
# ─────────────────────────────────────────────────────────
PROGRESS_PATH=./progress.json       # Resumability state — delete to restart
REPORT_PATH=./campaign_report.csv   # Final audit CSV
PREVIEW_PATH=./preview.html         # Dry-run output
PREVIEW_COUNT=3                     # How many emails to render in preview
